// Cron che avvia l'aggiornamento su GitHub ogni ora al minuto 17 (il repo è pubblico: minuti Actions illimitati).
// Le quote si riscaricano comunque ogni 3 ore (ritmo di API-Football), risultati ogni ora.
// Pubblicazione: npx wrangler deploy -c cron/wrangler.jsonc
{
  "name": "sporty-predict-cron",
  "main": "worker.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "triggers": { "crons": ["17 * * * *"] },
  "vars": { "REPO": "emadan96/sporty-predict", "WORKFLOW": "pubblica.yml" },
  "observability": { "enabled": true }
}
